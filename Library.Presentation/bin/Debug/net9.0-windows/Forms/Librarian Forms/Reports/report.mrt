using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using Stimulsoft.Report;
using Stimulsoft.Report.Viewer;
using System.Windows.Forms;

namespace Library.Presentation.Forms.Librarian_Forms
{
    public class Report
    {
        private StiReport stiReport;

        public Report()
        {
            stiReport = new StiReport();
        }

        public void LoadReport(string reportFileName, Control viewerControl)
        {
            try
            {
                // Ensure full path of the report file
                string reportPath = System.IO.Path.Combine(Application.StartupPath, "Reports", reportFileName);

                // Check if file exists
                if (!System.IO.File.Exists(reportPath))
                {
                    MessageBox.Show($"Report file not found: {reportPath}");
                    return;
                }

                stiReport.Load(reportPath);  // Load the .mrt file
                stiReport.Render();          // Render the report

                // Assign the report to the viewer
                if (viewerControl is StiViewerControl viewer)
                {
                    viewer.Report = stiReport;
                }
                else
                {
                    MessageBox.Show("Invalid Report Viewer Control.");
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading report: {ex.Message}");
            }
        }
    }
}